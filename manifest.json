{
  "manifest_version": 3,
  "name": "Inkout",
  "version": "1.0.0",
  "description": "Hides emails, phone numbers, card numbers and API keys on web pages while you share your screen.",
  "homepage_url": "https://kunalkumarkkr01.github.io/inkout/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Inkout",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "commands": {
    "toggle-masking": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Turn hiding on or off"
    },
    "blur-page": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Blur the whole page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/page-hooks.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/settings.js", "src/sites.js", "src/detectors.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
